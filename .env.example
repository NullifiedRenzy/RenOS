# RenOS Environment Configuration
# ================================
# Copy this file to .env and adjust for your environment.
# docker compose automatically reads .env if present.
#
# Quick start:
#   cp .env.example .env
#   docker compose up -d

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Connection string for the primary database.
# When running Core on the host: use localhost.
# When running Core in Docker: use postgres (service name).
RENOS_DATABASE_URL=postgres://renos:renos@localhost:5432/renos?sslmode=disable

# ─── NATS ────────────────────────────────────────────────────────────────────
# NATS server URL. JetStream is enabled in docker-compose.
RENOS_NATS_URL=nats://localhost:4222

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis URL for caching, sessions, and pub/sub.
RENOS_REDIS_URL=redis://localhost:6379/0

# ─── gRPC ────────────────────────────────────────────────────────────────────
# Port for the Agent-facing gRPC server.
# RENOS_GRPC_PORT=8444

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the HTTP API server (REST + WebSocket).
RENOS_PORT=8443
# Publicly-reachable URL. Used for enrollment tokens and links in notifications.
RENOS_EXTERNAL_URL=https://localhost:8443

# ─── Admin User (seeded on first boot) ───────────────────────────────────────
RENOS_ADMIN_EMAIL=admin@renos.local
RENOS_ADMIN_PASSWORD=admin

# ─── Auth ────────────────────────────────────────────────────────────────────
# HMAC key for signing JWTs. Auto-generated on first boot if not set.
# CHANGE THIS IN PRODUCTION — use a 256-bit random value.
RENOS_JWT_SECRET=dev-secret-do-not-use-in-production
# Master encryption key for secrets at rest.
# CHANGE THIS IN PRODUCTION — use a 256-bit random value.
RENOS_ENCRYPTION_KEY=dev-encryption-key-change-in-production

# ─── CA (Device Certificates) ────────────────────────────────────────────────
# Directory where the internal CA stores its key and certificates.
# Default (Linux): /var/lib/renos/ca
# Dev default: /tmp/renos/ca (avoids permission issues on first run)
RENOS_CA_CERT_DIR=/tmp/renos/ca

# ─── Agent ───────────────────────────────────────────────────────────────────
# How often agents send health reports (seconds).
# RENOS_AGENT_HEARTBEAT_INTERVAL=30
# How long without a heartbeat before marking an agent offline (seconds).
# RENOS_AGENT_OFFLINE_TIMEOUT=90

# ─── Logging ─────────────────────────────────────────────────────────────────
# Valid values: debug, info, warn, error
RENOS_LOG_LEVEL=debug

# ─── AI Providers (optional, not used in v0.1) ───────────────────────────────
# RENOS_AI_PROVIDER=ollama
# RENOS_AI_OLLAMA_URL=http://localhost:11434
# RENOS_AI_OPENAI_KEY=
# RENOS_AI_ANTHROPIC_KEY=

