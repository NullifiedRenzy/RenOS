# RenOS Environment Configuration
# ================================
# Copy this file to .env and adjust for your environment.
# docker compose automatically reads .env if present.
#
# Quick start (development):
#   cp .env.example .env
#   docker compose up -d
#
# Quick start (production):
#   ./install.sh
#
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: Set these before starting in production.
# The install.sh script auto-generates secure values for these.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# Connection string for the primary database.
# When running Core on the host: use localhost.
# When running Core in Docker: use postgres (service name).
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=disable
RENOS_DATABASE_URL=postgres://renos:renos@localhost:5432/renos?sslmode=disable

# PostgreSQL credentials (used by docker-compose for container init).
# POSTGRES_USER=renos
# POSTGRES_PASSWORD=renos
# POSTGRES_DB=renos

# ─── NATS ────────────────────────────────────────────────────────────────────
# NATS server URL. JetStream is enabled in docker-compose.
RENOS_NATS_URL=nats://localhost:4222

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis URL for caching, sessions, and pub/sub.
# Set to empty string to run without Redis (not recommended for production).
RENOS_REDIS_URL=redis://localhost:6379/0

# ─── gRPC ────────────────────────────────────────────────────────────────────
# Port for the Agent-facing gRPC server.
# RENOS_GRPC_PORT=8444

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the HTTP API server (REST + WebSocket).
RENOS_PORT=8443
# Publicly-reachable URL. Used for enrollment tokens and links in notifications.
# In production behind a reverse proxy, set this to your public domain.
RENOS_EXTERNAL_URL=https://localhost:8443

# ─── Admin User (seeded on first boot) ───────────────────────────────────────
# The first admin user is created automatically on first boot.
# The install.sh script will prompt for these interactively.
# NEVER use "admin" as the password in production.
RENOS_ADMIN_EMAIL=admin@renos.local
RENOS_ADMIN_PASSWORD=

# ─── Auth ────────────────────────────────────────────────────────────────────
# HMAC key for signing JWTs. Auto-generated by install.sh if not set.
# REQUIRED: Set a 256-bit random value (64 hex chars) before production use.
# NEVER commit this value to version control.
RENOS_JWT_SECRET=
# Master encryption key for secrets at rest (vault, OIDC clients, etc.).
# REQUIRED: Set a 256-bit random value (64 hex chars) before production use.
# NEVER commit this value to version control.
RENOS_ENCRYPTION_KEY=

# ─── CA (Device Certificates) ────────────────────────────────────────────────
# Directory where the internal CA stores its key and certificates.
# Default (Linux production): /var/lib/renos/ca
# Dev default: /tmp/renos/ca (avoids permission issues on first run)
RENOS_CA_CERT_DIR=/tmp/renos/ca

# ─── Agent ───────────────────────────────────────────────────────────────────
# How often agents send health reports (seconds).
# RENOS_AGENT_HEARTBEAT_INTERVAL=30
# How long without a heartbeat before marking an agent offline (seconds).
# RENOS_AGENT_OFFLINE_TIMEOUT=90

# ─── Logging ─────────────────────────────────────────────────────────────────
# Valid values: debug, info, warn, error
# Use "info" for production, "debug" for development.
RENOS_LOG_LEVEL=debug

# ─── Rate Limiting ───────────────────────────────────────────────────────────
# RENOS_RATE_LIMIT_LOGIN=5
# RENOS_RATE_LIMIT_LOGIN_BURST=10
# RENOS_RATE_LIMIT_API=50
# RENOS_RATE_LIMIT_API_BURST=100
# RENOS_RATE_LIMIT_WS_CONNECT=2
# RENOS_RATE_LIMIT_WS_CONNECT_BURST=5
# RENOS_MAX_WS_CONNS_PER_USER=10
# RENOS_MAX_BODY_SIZE=1048576

# ─── Worker Pool ─────────────────────────────────────────────────────────────
# RENOS_POOL_SIZE=5
# RENOS_MAX_CONCURRENT_JOBS=10
# RENOS_MAX_CONCURRENT_DEVICE_ACTIONS=20
# RENOS_CIRCUIT_BREAKER_THRESHOLD=5
# RENOS_CIRCUIT_BREAKER_RESET_AFTER=10m
# RENOS_DEFAULT_MAX_JOB_DURATION=30m

# ─── AI Providers (optional, not used in v0.1) ───────────────────────────────
# RENOS_AI_PROVIDER=ollama
# RENOS_AI_OLLAMA_URL=http://localhost:11434
# RENOS_AI_OPENAI_KEY=
# RENOS_AI_ANTHROPIC_KEY=

# ─── Production Docker Compose ───────────────────────────────────────────────
# For docker-compose.prod.yml only:
# IMAGE_OWNER=renos-project
# RENOS_HTTP_PORT=80
# RENOS_HTTPS_PORT=443
