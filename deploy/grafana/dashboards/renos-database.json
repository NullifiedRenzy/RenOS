{
  "title": "RenOS — Database",
  "uid": "renos-database",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "DB Queries Per Second",
      "type": "graph",
      "targets": [
        { "expr": "rate(renos_db_queries_total[1m])", "legendFormat": "{{operation}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "DB Query P99 Latency",
      "type": "graph",
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(renos_db_query_duration_ms_bucket[5m]))", "legendFormat": "{{operation}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "DB Pool Active Connections",
      "type": "graph",
      "targets": [
        { "expr": "renos_db_pool_active_connections", "legendFormat": "active" },
        { "expr": "renos_db_pool_idle_connections", "legendFormat": "idle" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "DB Pool Wait Duration (P99)",
      "type": "graph",
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(renos_db_pool_wait_duration_ms_bucket[5m]))", "legendFormat": "wait" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
