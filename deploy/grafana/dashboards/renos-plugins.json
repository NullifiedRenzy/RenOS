{
  "title": "RenOS — Plugins",
  "uid": "renos-plugins",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Plugin Executions",
      "type": "graph",
      "targets": [
        { "expr": "rate(renos_plugin_executions_total[1m])", "legendFormat": "{{plugin_id}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "Plugin Execution Duration (P99)",
      "type": "graph",
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(renos_plugin_execution_duration_ms_bucket[5m]))", "legendFormat": "{{plugin_id}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Active Plugin Workers",
      "type": "graph",
      "targets": [
        { "expr": "renos_plugin_workers_active", "legendFormat": "workers" }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    }
  ]
}
