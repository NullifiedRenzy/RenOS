{
  "title": "RenOS — AI & RenAI",
  "uid": "renos-ai",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "AI Prompt Rate",
      "type": "graph",
      "targets": [
        { "expr": "rate(renos_ai_prompts_total[1m])", "legendFormat": "{{provider}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "title": "AI Latency (P99)",
      "type": "graph",
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(renos_ai_latency_ms_bucket[5m]))", "legendFormat": "{{provider}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Token Usage Rate",
      "type": "graph",
      "targets": [
        { "expr": "rate(renos_ai_tokens_total[1m])", "legendFormat": "{{provider}}:{{type}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "title": "Provider Failures",
      "type": "graph",
      "targets": [
        { "expr": "rate(renos_ai_provider_failures_total[5m])", "legendFormat": "{{provider}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    }
  ]
}
