{
  "title": "RenOS — Agents & Devices",
  "uid": "renos-agents",
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "title": "Agents Online",
      "type": "graph",
      "targets": [
        { "expr": "renos_agents_online", "legendFormat": "online" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "title": "Total Registered Agents",
      "type": "singlestat",
      "targets": [
        { "expr": "renos_agents_total" }
      ],
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 }
    },
    {
      "title": "Heartbeat Latency (P99)",
      "type": "graph",
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(renos_agent_heartbeat_latency_ms_bucket[5m]))", "legendFormat": "{{agent_id}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "title": "Command Round-Trip Latency (P99)",
      "type": "graph",
      "targets": [
        { "expr": "histogram_quantile(0.99, rate(renos_agent_command_latency_ms_bucket[5m]))", "legendFormat": "{{command_type}}" }
      ],
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 }
    }
  ]
}
