# RenOS Docker Installer Environment Configuration
# ==================================================
# Copy this file to .env and customize for your deployment.
#
#   cp .env.example .env
#   docker compose up -d
#
# Required variables marked with ⚠ must be set before starting.
# Run ./run.sh for interactive setup, or edit this file manually.

# ─── Host Configuration ───────────────────────────────────────────────────────
# Public hostname for the RenOS dashboard.
# Used for enrollment tokens and external links.
RENOS_HOSTNAME=renos.local

# ─── Ports ────────────────────────────────────────────────────────────────────
RENOS_HTTP_PORT=80
RENOS_HTTPS_PORT=443

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=renos
# ⚠ Set a strong random password (run.sh generates one automatically)
POSTGRES_PASSWORD=changeme
POSTGRES_DB=renos

# ─── Redis ────────────────────────────────────────────────────────────────────
# ⚠ Set a strong random password
REDIS_PASSWORD=changeme

# ─── Core ─────────────────────────────────────────────────────────────────────
RENOS_EXTERNAL_URL=https://renos.local
RENOS_PORT=8443
RENOS_GRPC_PORT=8444
RENOS_LOG_LEVEL=info
RENOS_DATA_DIR=/var/lib/renos/data

# ─── JWT & Encryption ─────────────────────────────────────────────────────────
# ⚠ Generate with: openssl rand -hex 32
RENOS_JWT_SECRET=changeme
# ⚠ Generate with: openssl rand -hex 32
RENOS_ENCRYPTION_KEY=changeme

# ─── CA (Device Certificates) ─────────────────────────────────────────────────
RENOS_CA_CERT_DIR=/var/lib/renos/ca

# ─── Admin User (seeded on first boot) ────────────────────────────────────────
RENOS_ADMIN_EMAIL=admin@renos.local
# ⚠ Set a strong password (min 8 chars, not 'admin' or 'password')
RENOS_ADMIN_PASSWORD=changeme

# ─── Build ────────────────────────────────────────────────────────────────────
RENOS_VERSION=dev
BUILD_COMMIT=unknown
BUILD_TIME=unknown

# ─── Agent ────────────────────────────────────────────────────────────────────
RENOS_AGENT_HEARTBEAT_INTERVAL=30
RENOS_AGENT_OFFLINE_TIMEOUT=90

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RENOS_RATE_LIMIT_LOGIN=5
RENOS_RATE_LIMIT_LOGIN_BURST=10
RENOS_RATE_LIMIT_API=50
RENOS_RATE_LIMIT_API_BURST=100
RENOS_RATE_LIMIT_WS_CONNECT=2
RENOS_RATE_LIMIT_WS_CONNECT_BURST=5
RENOS_MAX_WS_CONNS_PER_USER=10
RENOS_MAX_BODY_SIZE=1048576

# ─── Worker Pool ──────────────────────────────────────────────────────────────
RENOS_POOL_SIZE=5
RENOS_MAX_CONCURRENT_JOBS=10
RENOS_MAX_CONCURRENT_DEVICE_ACTIONS=20
RENOS_CIRCUIT_BREAKER_THRESHOLD=5
RENOS_CIRCUIT_BREAKER_RESET_AFTER=10m
RENOS_DEFAULT_MAX_JOB_DURATION=30m

# ─── TLS ──────────────────────────────────────────────────────────────────────
# Set to "letsencrypt" for automatic cert provisioning, or "selfsigned" for dev.
# TLS_CERT_MODE=selfsigned
# TLS_EMAIL=admin@renos.local

# ─── Backup ───────────────────────────────────────────────────────────────────
# BACKUP_RETENTION_DAYS=30
# BACKUP_SCHEDULE="0 2 * * *"
