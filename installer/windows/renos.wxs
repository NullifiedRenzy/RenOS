<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Product
    Name="RenOS Agent"
    Id="*"
    UpgradeCode="A3D7F2E1-4B5C-4D6E-8F90-123456789ABC"
    Language="1033"
    Codepage="1252"
    Version="$(var.Version)"
    Manufacturer="RenOS">

    <Package
      Scope="perMachine"
      InstallScope="perMachine"
      Compressed="yes"
      Platforms="x64"
      Description="RenOS Agent – secure device management"
      Comments="RenOS Agent MSI Installer"
      Manufacturer="RenOS"
      InstallPrivileges="elevated"
      InstallerVersion="500" />

    <Media Id="1" Cabinet="renos.cab" EmbedCab="yes" CompressionLevel="high" />

    <!-- Upgrade logic: detect and remove previous versions -->
    <Upgrade Id="A3D7F2E1-4B5C-4D6E-8F90-123456789ABC">
      <UpgradeVersion OnlyDetect="no" Property="OLDVERSIONFOUND" Maximum="$(var.Version)" IncludeMaximum="no" MigrateFeatures="yes" />
      <UpgradeVersion OnlyDetect="yes" Property="NEWVERSIONFOUND" Minimum="$(var.Version)" IncludeMinimum="no" />
    </Upgrade>

    <InstallExecuteSequence>
      <RemoveExistingProducts Before="InstallInitialize" />
    </InstallExecuteSequence>

    <!-- Condition: only allow install on 64-bit Windows -->
    <Condition Message="RenOS Agent requires 64-bit Windows.">
      VersionNT64
    </Condition>

    <!-- Condition: Windows 10 / Windows Server 2016 or later -->
    <Condition Message="RenOS Agent requires Windows 10 / Windows Server 2016 or later.">
      (VersionNT >= 603)
    </Condition>

    <!-- Directory structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="RenOSDir" Name="RenOS">
        <Directory Id="INSTALLDIR" Name="Agent">
          <Directory Id="ScriptsDir" Name="Scripts" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="RenOSProgramMenu" Name="RenOS">
        <Directory Id="RenOSAgentShortcuts" Name="Agent" />
      </Directory>
    </StandardDirectory>

    <!-- Files -->
    <ComponentGroup Id="ProductComponents" Directory="INSTALLDIR">
      <Component Id="RenOSAgentExe" Bitness="always64" Guid="B1C2D3E4-F5A6-4B7C-8D9E-0F1A2B3C4D5E">
        <File Id="RenOSAgentExe" Name="renos-agent.exe" Source="$(var.SourceDir)\renos-agent.exe" KeyPath="yes" Checksum="yes" />
        <ServiceInstall
          Id="RenOSAgentServiceInstall"
          Type="ownProcess"
          Vital="yes"
          Name="RenOS-Agent"
          DisplayName="RenOS Agent"
          Description="RenOS device management and enrollment agent"
          Start="auto"
          Account="NT AUTHORITY\SYSTEM"
          ErrorControl="normal"
          Arguments="-config &quot;[#RenOSConfigJson]&quot;"
          Interactive="no" />
        <ServiceControl
          Id="RenOSAgentServiceControl"
          Name="RenOS-Agent"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>

      <Component Id="RenOSConfigJson" Bitness="always64" Guid="F6E5D4C3-B2A1-4C8B-9D0E-1F2A3B4C5D6E">
        <File Id="RenOSConfigJson" Name="config.json" Source="$(var.SourceDir)\config.json" KeyPath="yes" />
      </Component>

      <Component Id="RenOSEnrollmentWizard" Bitness="always64" Guid="8A9B0C1D-2E3F-4A5B-6C7D-8E9F0A1B2C3D">
        <File Id="RenOSEnrollmentWizard" Name="enrollment-wizard.ps1" Source="$(var.SourceDir)\enrollment-wizard.ps1" KeyPath="yes" />
      </Component>

      <Component Id="RenOSServiceScript" Bitness="always64" Guid="1A2B3C4D-5E6F-4A7B-8C9D-0E1F2A3B4C5D">
        <File Id="RenOSServiceScript" Name="renos-agent-service.ps1" Source="$(var.SourceDir)\renos-agent-service.ps1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu Shortcuts -->
    <ComponentGroup Id="ShortcutComponents" Directory="RenOSAgentShortcuts">
      <Component Id="RenOSAgentShortcutsComp" Guid="2B3C4D5E-6F7A-4B8C-9D0E-1F2A3B4C5D6E">
        <Shortcut Id="RenOSEnrollmentWizardShortcut"
                  Name="RenOS Enrollment Wizard"
                  Description="Launch the RenOS enrollment wizard"
                  Target="[System64Folder]WindowsPowerShell\v1.0\powershell.exe"
                  Arguments="-NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File &quot;[INSTALLDIR]enrollment-wizard.ps1&quot;" />
        <Shortcut Id="RenOSAgentConfigShortcut"
                  Name="RenOS Agent Config"
                  Description="Open RenOS agent configuration directory"
                  Target="[INSTALLDIR]"
                  Directory="RenOSAgentShortcuts" />
        <Shortcut Id="RenOSUninstallShortcut"
                  Name="Uninstall RenOS Agent"
                  Description="Remove RenOS Agent from this computer"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />
        <RemoveFolder Id="RenOSAgentShortcutsRemove" Directory="RenOSAgentShortcuts" On="uninstall" />
        <RemoveFolder Id="RenOSProgramMenuRemove" Directory="RenOSProgramMenu" On="uninstall" />
      </Component>
    </ComponentGroup>

    <!-- Registry entries -->
    <ComponentGroup Id="RegistryComponents" Directory="INSTALLDIR">
      <Component Id="RenOSRegistryConfig" Bitness="always64" Guid="3C4D5E6F-7A8B-4C9D-0E1F-2A3B4C5D6E7F">
        <RegistryKey Root="HKLM" Key="Software\RenOS">
          <RegistryValue Type="string" Name="InstallPath" Value="[INSTALLDIR]" />
          <RegistryValue Type="string" Name="Version" Value="$(var.Version)" />
          <RegistryValue Type="string" Name="ConfigPath" Value="[INSTALLDIR]config.json" />
          <RegistryValue Type="integer" Name="Installed" Value="1" />
        </RegistryKey>
      </Component>
    </ComponentGroup>

    <!-- Firewall rules via custom action -->
    <CustomActionRef Id="AddFirewallRules" />

    <!-- Scheduled task via custom action -->
    <CustomActionRef Id="CreateScheduledTask" />

    <!-- Launch enrollment wizard on first install -->
    <CustomActionRef Id="LaunchEnrollmentWizard" />

    <!-- Cleanup on uninstall -->
    <CustomActionRef Id="RemoveFirewallRules" />
    <CustomActionRef Id="RemoveScheduledTask" />

    <!-- Custom actions -->
    <CustomAction Id="AddFirewallRules"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveFirewallRules"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="CreateScheduledTask"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveScheduledTask"
                  BinaryKey="WixCA"
                  DllEntry="WixQuietExec"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="LaunchEnrollmentWizard"
                  BinaryKey="WixCA"
                  DllEntry="WixShellExec"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="ignore" />

    <Property Id="WixShellExecTarget"
              Value="[System64Folder]WindowsPowerShell\v1.0\powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Normal -File &quot;[INSTALLDIR]enrollment-wizard.ps1&quot;" />

    <!-- Schedule custom actions in install sequence -->
    <InstallExecuteSequence>
      <!-- Firewall: add rules before service starts -->
      <Custom Action="AddFirewallRules"
              Before="StartServices">
        NOT Installed AND NOT REMOVE
      </Custom>

      <!-- Scheduled task: create after files are installed -->
      <Custom Action="CreateScheduledTask"
              After="InstallFiles">
        NOT Installed AND NOT REMOVE
      </Custom>

      <!-- Launch enrollment wizard after install completes -->
      <Custom Action="LaunchEnrollmentWizard"
              After="InstallFinalize">
        NOT Installed AND NOT REMOVE
      </Custom>

      <!-- Firewall: remove rules on uninstall -->
      <Custom Action="RemoveFirewallRules"
              Before="RemoveFiles">
        REMOVE
      </Custom>

      <!-- Cleanup scheduled task on uninstall -->
      <Custom Action="RemoveScheduledTask"
              Before="RemoveFiles">
        REMOVE
      </Custom>
    </InstallExecuteSequence>

    <!-- UI: minimal wizard -->
    <UI>
      <UIRef Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchEnrollmentWizard"
               Order="1">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed</Publish>
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX"
                Value="1"
                Admin="yes"
                Hidden="no"
                Secure="yes" />
      <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
                Value="Launch enrollment wizard" />
    </UI>

    <WixVariable Id="WixUILicenseRtf" Value="" />
    <WixVariable Id="WixUIDialogBmp" Value="" />
    <WixVariable Id="WixUIBannerBmp" Value="" />

    <Feature Id="ProductFeature"
             Title="RenOS Agent"
             Description="Core RenOS agent service and enrollment tools"
             Level="1"
             ConfigurableDirectory="INSTALLDIR"
             Display="expand">
      <Feature Id="MainFeature"
               Title="Agent Service"
               Description="RenOS Agent Windows service"
               Level="1">
        <ComponentGroupRef Id="ProductComponents" />
      </Feature>
      <Feature Id="ShortcutsFeature"
               Title="Start Menu Shortcuts"
               Description="RenOS shortcuts in Start Menu"
               Level="1">
        <ComponentGroupRef Id="ShortcutComponents" />
      </Feature>
      <Feature Id="RegistryFeature"
               Title="Registry Configuration"
               Description="Registry entries under HKLM\Software\RenOS"
               Level="1">
        <ComponentGroupRef Id="RegistryComponents" />
      </Feature>
    </Feature>
  </Product>
</Wix>
